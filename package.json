{
  "name": "chatpymol",
  "version": "0.2.0",
  "description": "AI-human collaborative, versioned PyMOL workspace for the browser, CLI, Codex, and Claude Code.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IveGotMagicBean/ChatPyMol.git"
  },
  "homepage": "https://github.com/IveGotMagicBean/ChatPyMol#readme",
  "bugs": {
    "url": "https://github.com/IveGotMagicBean/ChatPyMol/issues"
  },
  "keywords": [
    "pymol",
    "protein-visualization",
    "molecular-visualization",
    "webassembly",
    "pml",
    "mcp",
    "codex",
    "claude-code",
    "ai-collaboration"
  ],
  "type": "module",
  "bin": {
    "chatpymol": "./bin/chatpymol.mjs"
  },
  "files": [
    ".env.example",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "third_party/",
    "bin/chatpymol.mjs",
    "dist/",
    "docs/",
    "integrations/",
    "server/index.mjs",
    "server/examples/",
    "server/lib/ai-provider.mjs",
    "server/lib/ai.mjs",
    "server/lib/chatpymol-service.mjs",
    "server/lib/event-hub.mjs",
    "server/lib/fs-store.mjs",
    "server/lib/mcp-server.mjs",
    "server/lib/pml-skills.mjs",
    "server/lib/project-export.mjs",
    "server/skills/",
    "vendor/patinae/README.md",
    "vendor/patinae/package.json",
    "vendor/patinae/dist/",
    "vendor/patinae/pkg/"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"node --watch server/index.mjs\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.mjs",
    "record:tour": "node scripts/record-product-tour.mjs",
    "test": "node --test",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@patinae/viewer": "file:vendor/patinae",
    "archiver": "^8.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "playwright": "^1.62.0",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
