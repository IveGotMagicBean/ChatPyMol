PORT=8787
HOST=0.0.0.0
DATA_DIR=./data
CHATPYMOL_PUBLIC_URL=

# 阿里云百炼（OpenAI 兼容接口）。模型名请替换为账号实际可用的模型。
# 同时配置百炼与 OpenAI 时，ChatPyMOL 优先使用百炼。
DASHSCOPE_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen3.7-max

# OpenAI Responses API（百炼未配置时使用）。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra

# 两个 API key 都留空时，使用内置的有限本地规则模式。

# 单个结构文件上限，单位 MB。
MAX_UPLOAD_MB=50

# 可选：切换到另一个经过浏览器回归验证的 PyMOL-WASM wheel。
# 留空时使用随项目保存的稳定版；新旧 wheel 应始终以不同文件名并存。
VITE_PYMOL_WHEEL=
